# Copy to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=internship_tracking.settings.development
SECRET_KEY=replace-with-a-long-random-development-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL-first configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internship_tracking

# Explicit local fallback only. Remove DATABASE_URL and set this to True to use SQLite.
USE_SQLITE=False

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
LOG_LEVEL=INFO
