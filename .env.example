# Copy to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=internship_tracking.settings.development
SECRET_KEY=replace-with-a-long-random-development-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Development uses Django's built-in SQLite database by default.
USE_SQLITE=True

# PostgreSQL can be enabled later by setting USE_SQLITE=False and uncommenting this:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internship_tracking

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
LOG_LEVEL=INFO
